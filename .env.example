# Copy this file to .env and change the values. Never commit .env.

# Password of the PostgreSQL database
APP_DB_PASSWORD=change-me

# Key that signs the JWTs: a random string of at least 32 characters
JWT_KEY=change-me-to-a-long-random-secret-of-32-plus-chars

# Optional: how long a login token lasts, in minutes (at most 1440 = one day). Default 60.
# JWT_EXPIRY_MINUTES=1440

# The admin account created when the app starts
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=change-me-strong-password

# Password of the inventory service's own PostgreSQL database (Requirement 2)
INVENTORY_DB_PASSWORD=change-me-too

# Requirement 4: RabbitMQ, the external mail service (SMTP) and Soketi (live updates)
RABBITMQ_USER=shop
RABBITMQ_PASSWORD=change-me

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_FROM=Online Shop <shop@onlineshop.test>

REALTIME_APP_ID=onlineshop
REALTIME_KEY=change-me-public-key
REALTIME_SECRET=change-me-long-secret
