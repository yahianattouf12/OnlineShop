# Copy this file to .env and change the values. Never commit .env.

# Password of the PostgreSQL database
APP_DB_PASSWORD=change-me

# Key that signs the JWTs: a random string of at least 32 characters
JWT_KEY=change-me-to-a-long-random-secret-of-32-plus-chars

# The admin account created when the app starts
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=change-me-strong-password

# Password of the inventory service's own PostgreSQL database (Requirement 2)
INVENTORY_DB_PASSWORD=change-me-too